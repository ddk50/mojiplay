{
  "name": "myfonteditor",
  "version": "1.0.0",
  "description": "Desktop font layout editor",
  "author": "kazushi",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json",
    "bundle:vendor": "esbuild node_modules/fontkit/dist/browser-module.mjs --bundle --format=iife --global-name=fontkit --outfile=renderer/vendor/fontkit.js --platform=browser --minify",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win --x64",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "fabric": "5.3.0"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.11",
    "@types/node": "^25.6.0",
    "electron": "^29.0.0",
    "electron-builder": "^24.13.3",
    "esbuild": "^0.28.0",
    "fontkit": "^2.0.4",
    "typescript": "^6.0.2"
  },
  "build": {
    "appId": "com.kazushi.mojiplay",
    "productName": "mojiplay",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.exe"
    }
  }
}
