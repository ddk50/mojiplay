{
  "name": "myfonteditor",
  "version": "1.0.0",
  "description": "Desktop font layout editor",
  "author": "kazushi",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:typecheck": "tsc -p tsconfig.renderer.json",
    "build:renderer": "node esbuild.renderer.mjs",
    "build": "npm run build:main && npm run build:typecheck && npm run build:renderer",
    "watch:renderer": "node esbuild.renderer.mjs --watch",
    "bundle:vendor": "esbuild node_modules/fontkit/dist/browser-module.mjs --bundle --format=iife --global-name=fontkit --outfile=renderer/vendor/fontkit.js --platform=browser --minify",
    "bundle:fabric": "cp node_modules/fabric/dist/fabric.min.js renderer/vendor/fabric.min.js",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --win --dir",
    "dist:win": "npm run build && electron-builder --win --x64",
    "test": "jest"
  },
  "dependencies": {
    "electron-log": "^5.4.3",
    "ulid": "^3.0.2"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.6.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "fabric": "5.3.0",
    "fontkit": "^2.0.4",
    "jest": "^30.3.0",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.2"
  },
  "build": {
    "appId": "com.kazushi.mojiplay",
    "productName": "mojiplay",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable-${arch}.exe"
    }
  }
}
