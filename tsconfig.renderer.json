{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "types": ["fabric"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/core/**/*.ts",
    "src/renderer/**/*.ts",
    "src/globals/**/*.d.ts"
  ]
}
