{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "types": ["fabric"],
    "outDir": "dist/renderer",
    "rootDir": "src/renderer"
  },
  "include": ["src/renderer/**/*.ts", "src/types/**/*.d.ts"]
}
