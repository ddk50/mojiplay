{
  "compilerOptions": {
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "skipLibCheck": true,
    "strict": true,
    "lib": ["ES2020", "DOM"],
    "types": ["fabric"],
    "allowUmdGlobalAccess": true,
    "noEmit": true,
    "rootDir": "src"
  },
  "include": ["src/window/**/*.ts", "src/globals/**/*.d.ts"]
}
