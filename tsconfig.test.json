{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist-test",
    "rootDir": ".",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "jest", "fabric"],
    "allowUmdGlobalAccess": true
  },
  "include": ["test/**/*.ts", "src/globals/**/*.d.ts"]
}
